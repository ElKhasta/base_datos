# Copia este archivo como .env y ajusta la contrasena de PostgreSQL.
DATABASE_URL=postgresql://postgres:TU_CONTRASENA@localhost:5432/renta_equipos

# Origenes extra permitidos para el front (Live Server de VS Code)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# Sesiones y roles
# Genera una cadena larga y aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
SESSION_HORAS=8
COOKIE_SECURE=false

# Usuarios demo que se crean al arrancar la API si no existen
SEMBRAR_USUARIOS=true
ADMIN_EMAIL=admin@rentavisual.mx
ADMIN_PASSWORD=Admin123!
DEMO_CLIENTE_ID=1
DEMO_CLIENTE_EMAIL=luis@rentavisual.mx
DEMO_CLIENTE_PASSWORD=Cliente123!

# Ruta opcional del frontend (por defecto ../frontend)
# FRONTEND_DIR=C:\Users\tu_usuario\base_datos\frontend
