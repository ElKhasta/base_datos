{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API RentaVisual (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "justMyCode": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Prueba de humo de la API",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/scripts/prueba_api.py",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ]
}
